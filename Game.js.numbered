   1: import { Player } from './Player.js';
   1: import { ObstacleManager } from './ObstacleManager.js';
   1: import { RhythmEffect } from './RhythmEffect.js';
   1: import { UIController } from './UIController.js';
   1: import { ORBIT } from './Config.js';
   1: 
   1: // Game - main controller
   1: export class Game {
   1:     constructor(canvas) {
   1:         this.canvas = canvas;
   1:         this.ctx = canvas.getContext('2d');
   1:         this.centerX = canvas.width / 2;
   1:         this.centerY = canvas.height / 2;
   1:         this.orbitRadius = 160;
   1:         this.playerRadius = 15;
   1:         this.offscreenRadius = Math.hypot(canvas.width / 2, canvas.height / 2) + 40;
   1: 
   1:         // Entities
   1:         this.player = new Player(this.centerX, this.centerY, this.orbitRadius, this.playerRadius);
   1:         this.obstacleManager = new ObstacleManager(this.centerX, this.centerY, this.orbitRadius);
   1:         this.rhythmEffect = new RhythmEffect();
   1: 
   1:         // State
   1:         this.gameStarted = false;
   1:         this.gameOver = false;
   1:         this.animationId = null;
   1:         this.scoreSeconds = 0;
   1:         this._lastTime = null;
   1: 
   1:         // UI
   1:         this.startScreen = document.getElementById('startScreen');
   1:         this.startButton = document.getElementById('startButton');
   1:         this.gameOverScreen = document.getElementById('gameOverScreen');
   1:         this.restartButton = document.getElementById('restartButton');
   1:         this.scoreDisplay = document.getElementById('scoreDisplay');
   1:         this.ui = new UIController();
   1: 
   1:         this.setupEventListeners();
   1:     }
   1: 
   1:     setupEventListeners() {
   1:         this.ui.bind({ onStart: () => this.startGame(), onRestart: () => this.restartGame() });
   1: 
   1:         document.addEventListener('keydown', (event) => {
   1:             if (!this.gameStarted && event.code === 'Space') {
   1:                 event.preventDefault();
   1:                 this.startGame();
   1:             } else if (this.gameStarted && !this.gameOver && event.code === 'Space') {
   1:                 event.preventDefault();
   1:                 this.player.reverseDirection();
   1:             } else if (this.gameOver && event.code === 'Space') {
   1:                 event.preventDefault();
   1:                 this.restartGame();
   1:             }
   1:         });
   1:     }
   1: 
   1:     startGame() {
   1:         this.gameStarted = true;
   1:         this.gameOver = false;
   1:         this.scoreSeconds = 0;
   1:         this._lastTime = null;
   1:         this.ui.hideOverlays();
   1:         this.animationId = requestAnimationFrame((t) => this.animate(t));
   1:     }
   1: 
   1:     gameOverScreenShow() {
   1:         this.gameOver = true;
   1:         if (this.animationId) {
   1:             cancelAnimationFrame(this.animationId);
   1:             this.animationId = null;
   1:         }
   1:         // Final score (seconds) on game over screen
   1:         this.ui.showGameOver(Math.floor(this.scoreSeconds));
   1:     }
   1: 
   1:     restartGame() {
   1:         // Reset state
   1:         this.gameOver = false;
   1:         this.gameStarted = false;
   1:         this.scoreSeconds = 0;
   1:         this._lastTime = null;
   1: 
   1:         // Recreate entities
   1:         this.player = new Player(this.centerX, this.centerY, this.orbitRadius, this.playerRadius);
   1:         this.obstacleManager = new ObstacleManager(this.centerX, this.centerY, this.orbitRadius);
   1:         this.rhythmEffect = new RhythmEffect();
   1: 
   1:         // Hide overlays and immediately start
   1:         this.ui.hideOverlays();
   1:         this.startGame();
   1:     }
   1: 
   1:     drawOrbit() {
   1:         this.ctx.strokeStyle = ORBIT.color;
   1:         this.ctx.lineWidth = ORBIT.lineWidth;
   1:         this.ctx.beginPath();
   1:         this.ctx.arc(this.centerX, this.centerY, this.orbitRadius, 0, 2 * Math.PI);
   1:         this.ctx.stroke();
   1:     }
   1: 
   1:     animate(now) {
   1:         if (!this.gameOver) {
   1:             // time-based delta (ms -> s)
   1:             if (typeof now !== 'number') now = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
   1:             if (this._lastTime == null) this._lastTime = now;
   1:             const dt = (now - this._lastTime) / 1000;
   1:             this._lastTime = now;
   1:             // Increase score: 1 point per second
   1:             this.scoreSeconds += dt;
   1: 
   1:             // Update rhythm effect
   1:             this.rhythmEffect.update();
   1: 
   1:             // Clear screen
   1:             // Ensure a clean transform each frame to avoid accumulated transforms across restarts
   1:             if (this.ctx.setTransform) {
   1:                 this.ctx.setTransform(1, 0, 0, 1, 0, 0);
   1:             }
   1:             this.ctx.fillStyle = '#000000';
   1:             this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
   1: 
   1:             // Apply rhythm effect ONLY to background orbit
   1:             this.rhythmEffect.applyTransform(this.ctx, this.centerX, this.centerY);
   1:             this.drawOrbit();
   1:             this.rhythmEffect.restoreTransform(this.ctx);
   1: 
   1:             // Update obstacles (no rhythm effect)
   1:             this.obstacleManager.update();
   1: 
   1:             // Collision (no active transform)
   1:             for (const obstacle of this.obstacleManager.obstacles) {
   1:                 if (this.player.checkCollisionWithObstacle(obstacle)) {
   1:                     this.gameOverScreenShow();
   1:                     return;
   1:                 }
   1:             }
   1: 
   1:             // Draw obstacles (no rhythm effect)
   1:             this.obstacleManager.draw(this.ctx);
   1: 
   1:             // Spawn acceleration by score (displayed seconds)
   1:             const visibleScore = Math.floor(this.scoreSeconds);
   1:             this.obstacleManager.applySpawnAcceleration(visibleScore);
   1: 
   1:             // Spawn
   1:             if (this.obstacleManager.shouldSpawn()) {
   1:                 this.obstacleManager.spawnObstacle(this.offscreenRadius);
   1:                 this.obstacleManager.resetSpawnTimer();
   1:             }
   1: 
   1:             // Player (apply rhythm effect ONLY to the player)
   1:             this.player.update();
   1:             this.rhythmEffect.applyTransform(this.ctx, this.centerX, this.centerY);
   1:             this.player.draw(this.ctx);
   1:             this.rhythmEffect.restoreTransform(this.ctx);
   1: 
   1:             // Draw score (centered in orbit with transparency)
   1:             this.ui.drawScore(this.ctx, this.scoreSeconds, this.centerX, this.centerY, this.orbitRadius);
   1:         }
   1: 
   1:         this.animationId = requestAnimationFrame((t) => this.animate(t));
   1:     }
   1: }
