import { Player } from './Player.js';\nimport { ObstacleManager } from './ObstacleManager.js';\nimport { RhythmEffect } from './RhythmEffect.js';\n\n// Game ?�래??- ?�체 게임 관�?export class Game {\n    constructor(canvas) {\n        this.canvas = canvas;\n        this.ctx = canvas.getContext('2d');\n        this.centerX = canvas.width / 2;\n        this.centerY = canvas.height / 2;\n        this.orbitRadius = 160;\n        this.playerRadius = 15;\n        this.offscreenRadius = Math.hypot(canvas.width / 2, canvas.height / 2) + 40;\n        \n        // 게임 객체??        this.player = new Player(this.centerX, this.centerY, this.orbitRadius, this.playerRadius);\n        this.obstacleManager = new ObstacleManager(this.centerX, this.centerY, this.orbitRadius);\n        this.rhythmEffect = new RhythmEffect();\n        \n        // 게임 ?�태\n        this.gameStarted = false;\n        this.gameOver = false;\n        this.animationId = null;\n        this.score = 0;\n        \n        // UI ?�소??        this.startScreen = document.getElementById('startScreen');\n        this.startButton = document.getElementById('startButton');\n        this.gameOverScreen = document.getElementById('gameOverScreen');\n        this.restartButton = document.getElementById('restartButton');\n        this.scoreDisplay = document.getElementById('scoreDisplay');\n        \n        this.setupEventListeners();\n    }\n    \n    setupEventListeners() {\n        this.startButton.addEventListener('click', () => this.startGame());\n        this.restartButton.addEventListener('click', () => this.restartGame());\n        \n        document.addEventListener('keydown', (event) => {\n            if (!this.gameStarted && event.code === 'Space') {\n                event.preventDefault();\n                this.startGame();\n            } else if (this.gameStarted && !this.gameOver && event.code === 'Space') {\n                event.preventDefault();\n                this.player.reverseDirection();\n            } else if (this.gameOver && event.code === 'Space') {\n                event.preventDefault();\n                this.restartGame();\n            }\n        });\n    }\n    \n    startGame() {\n        this.gameStarted = true;\n        this.gameOver = false;\n        this.score = 0;\n        this.startScreen.style.display = 'none';\n        this.gameOverScreen.style.display = 'none';\n        this.animate();\n    }\n    \n    gameOverScreenShow() {\n        this.gameOver = true;\n        this.gameOverScreen.style.display = 'flex';\n        this.scoreDisplay.textContent = `?�수: ${this.score}`;\n        if (this.animationId) {\n            cancelAnimationFrame(this.animationId);\n        }\n        this.scoreDisplay.textContent = `?�수: ${Math.floor(this.score / 60)}`;\n    }\n    \n    restartGame() {\n        // 게임 ?�태 초기??        this.gameOver = false;\n        this.gameStarted = false;\n        this.score = 0;\n        \n        // 게임 객체???�생??        this.player = new Player(this.centerX, this.centerY, this.orbitRadius, this.playerRadius);\n        this.obstacleManager = new ObstacleManager(this.centerX, this.centerY, this.orbitRadius);\n        this.rhythmEffect = new RhythmEffect();\n        \n        // ?�면 ?�환\n        this.gameOverScreen.style.display = 'none';\n        this.startScreen.style.display = 'flex';\n        this.startGame();\n    }\n    \n    drawOrbit() {\n        this.ctx.strokeStyle = '#ffffff';\n        this.ctx.lineWidth = 2;\n        this.ctx.beginPath();\n        this.ctx.arc(this.centerX, this.centerY, this.orbitRadius, 0, 2 * Math.PI);\n        this.ctx.stroke();\n    }\n    \n    animate() {\n        // 게임 ?�버 ?�태가 ?�닐 ?�만 게임 진행\n        if (!this.gameOver) {\n            // ?�수 증�? (?�레?�당)\n            this.score++;\n            \n            // 리듬 ?�과 ?�데?�트\n            this.rhythmEffect.update();\n            \n            // ?�면 지?�기\n            this.ctx.fillStyle = '#000000';\n            this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);\n            \n            // 리듬 ?�과 ?�용\n            this.rhythmEffect.applyTransform(this.ctx, this.centerX, this.centerY);\n            \n            // 궤도 그리�?            this.drawOrbit();\n            \n            // ?�애�?관�?            this.obstacleManager.update();\n            \n            // 충돌 검??            for (const obstacle of this.obstacleManager.obstacles) {\n                if (this.player.checkCollisionWithObstacle(obstacle)) {\n                    this.gameOverScreenShow();\n                    return;\n                }\n            }\n            \n            this.obstacleManager.draw(this.ctx);\n            \n            // ?�애�??�폰\n            if (this.obstacleManager.shouldSpawn()) {\n                this.obstacleManager.spawnObstacle(this.offscreenRadius);\n                this.obstacleManager.resetSpawnTimer();\n            }\n            \n            // 주인�??�데?�트 �?그리�?            this.player.update();\n            this.player.draw(this.ctx);\n            \n            // 리듬 ?�과 복원\n            this.rhythmEffect.restoreTransform(this.ctx);\n            \n            // ?�수 ?�시\n            this.ctx.fillStyle = '#ffffff';\n            this.ctx.font = '20px Arial';\n            this.scoreDisplay.textContent = `?�수: ${Math.floor(this.score / 60)}`;\n            this.ctx.fillText(`?�수: ${Math.floor(this.score / 60)}`, 20, 40);\n            this.ctx.fillText(`?�수: ${Math.floor(this.score / 60)}`, 20, 40);\n        }\n        \n        // ?�니메이??계속\n        this.animationId = requestAnimationFrame(() => this.animate());\n    }\n}\n
